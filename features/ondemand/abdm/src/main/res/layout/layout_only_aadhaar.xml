<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fl_doNotHaveABHANumber"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/margin_20"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_15"
        app:endIconMode="@null"
        app:hintEnabled="false"
        app:passwordToggleEnabled="false"
        app:passwordToggleTint="@android:color/transparent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/aadharNoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_textbox_outline"
            android:hint="@string/enter_your_aadhar_card_number"
            android:imeOptions="actionNext"
            android:inputType="numberPassword"
            android:maxLength="12"
            android:padding="14dp"
            android:singleLine="true"
            android:textAppearance="@style/type_mobile_no"
            android:textColor="@null"
            android:textColorHint="@color/hint_color"
            android:textSize="@null" />

        <TextView
            android:id="@+id/aadhar_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/hamburger_margin_start"
            android:lineSpacingExtra="0sp"
            android:text="@string/this_field_is_mandatory"
            android:textAppearance="@style/style_error_message"
            android:textColor="@color/red"
            android:textSize="@null"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.google.android.material.textfield.TextInputLayout>

    <android.widget.CheckBox
        android:id="@+id/cvTermsAndCondition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_10"
        android:text="@string/i_agree_terms_amp_conditions"
        android:textColor="@color/primary_text" />

</LinearLayout>