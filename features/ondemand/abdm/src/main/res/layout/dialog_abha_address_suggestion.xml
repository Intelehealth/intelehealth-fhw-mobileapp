<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="@dimen/margin_10"
        android:src="@drawable/ic_clear"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/aadhar_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:lineSpacingExtra="0sp"
        android:paddingHorizontal="@dimen/margin_20"
        android:paddingBottom="@dimen/margin_20"
        android:text="@string/the_abha_address_can_contain_alphanumeric_with_a_single_dot_and_underscore_allowed_in_the_middle_but_not_at_the_beginning_or_end"
        android:textAppearance="@style/style_error_message"
        android:textColor="@color/black"
        android:textSize="@null" />
</LinearLayout>