<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fl_haveABHANumber"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/margin_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <android.widget.Button
                android:id="@+id/button_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_12"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_abha_option"
                android:paddingStart="@dimen/margin_12"
                android:paddingTop="@dimen/margin_8"
                android:paddingEnd="@dimen/margin_12"
                android:paddingBottom="@dimen/margin_8"
                android:text="@string/aadhar_number"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_14" />

            <android.widget.Button
                android:id="@+id/button_mobile_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_abha_option"
                android:paddingStart="@dimen/margin_12"
                android:paddingTop="@dimen/margin_8"
                android:paddingEnd="@dimen/margin_12"
                android:paddingBottom="@dimen/margin_8"
                android:text="@string/mobile_number"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_14"
                android:visibility="visible" />
        </LinearLayout>

        <android.widget.Button
            android:id="@+id/button_abha_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_12"
            android:background="@drawable/bg_btn_abha_option"
            android:paddingStart="@dimen/margin_12"
            android:paddingTop="@dimen/margin_8"
            android:paddingEnd="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_8"
            android:text="@string/abha"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_14" />


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llAadharMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layout_parent_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_24"
                        android:text="@string/enter_username2"
                        android:textColor="@color/textColorBlack"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_20"
                        android:text="@string/enter_username_given"
                        android:textColor="@color/textColorGray"
                        android:textSize="@dimen/text_14"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_15"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edittext_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_textbox_outline"
                            android:hint="@string/enter_your_aadhar_card_number"
                            android:imeOptions="actionNext"
                            android:inputType="numberPassword"
                            android:maxLength="12"
                            android:padding="14dp"
                            android:singleLine="true"
                            android:textAppearance="@style/type_mobile_no"
                            android:textColor="@null"
                            android:textColorHint="@color/hint_color"
                            android:textSize="@null" />

                        <TextView
                            android:id="@+id/aadhar_error"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/hamburger_margin_start"
                            android:lineSpacingExtra="0sp"
                            android:text="@string/this_field_is_mandatory"
                            android:textAppearance="@style/style_error_message"
                            android:textColor="@color/red"
                            android:textSize="@null"
                            android:visibility="gone"
                            tools:visibility="visible" />


                    </com.google.android.material.textfield.TextInputLayout>


                    <TextView
                        android:id="@+id/tv_username_error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/hamburger_margin_start"
                        android:lineSpacingExtra="0sp"
                        android:text="@string/enter_username"
                        android:textAppearance="@style/style_error_message"
                        android:textColor="@color/red"
                        android:textSize="@null"
                        android:visibility="gone" />

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/layout_parent_mobile_no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/textview_enter_mobileno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_24"
                        android:text="@string/enter_mobile_no"
                        android:textColor="@color/textColorBlack"
                        android:textSize="@dimen/margin_16"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textview_mobile_no_note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/textview_enter_mobileno"
                        android:layout_marginTop="@dimen/margin_20"
                        android:text="@string/enter_mobile_no_given"
                        android:textColor="@color/textColorGray"
                        android:textSize="@dimen/text_14"
                        android:visibility="gone" />

                    <com.hbb20.CountryCodePicker
                        android:id="@+id/countrycode_spinner_forgot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/textview_mobile_no_note"
                        android:layout_marginTop="@dimen/margin_15"
                        android:layout_marginEnd="@dimen/margin_15"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner"
                        android:gravity="center_vertical"
                        android:textSize="@dimen/text_16"
                        android:visibility="gone"
                        app:ccp_countryPreference="us,in"
                        app:ccp_textSize="@dimen/text_16" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/textview_mobile_no_note"
                        android:layout_marginTop="@dimen/margin_15"
                        android:layout_toEndOf="@+id/countrycode_spinner_forgot"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edittext_mobile_number"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_textbox_outline"
                            android:hint="@string/enter_mobile_no"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:lineSpacingExtra="3sp"
                            android:maxLength="10"
                            android:padding="14dp"
                            android:singleLine="true"
                            android:textAppearance="@style/type_mobile_no"
                            android:textColor="@null"
                            android:textColorHint="@color/hint_color"
                            android:textSize="@null" />

                        <TextView
                            android:id="@+id/mobile_error"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/hamburger_margin_start"
                            android:lineSpacingExtra="0sp"
                            android:text="@string/this_field_is_mandatory"
                            android:textAppearance="@style/style_error_message"
                            android:textColor="@color/red"
                            android:textSize="@null"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </com.google.android.material.textfield.TextInputLayout>


                </RelativeLayout>


            </LinearLayout>

            <FrameLayout
                android:id="@+id/flAbhaDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <include
                    android:id="@+id/abhaDetails"
                    layout="@layout/layout_abha_details" />
            </FrameLayout>

        </FrameLayout>

        <CheckBox
            android:id="@+id/cvTermsAndCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_10"
            android:text="@string/i_agree_terms_amp_conditions"
            android:textColor="@color/primary_text" />

    </LinearLayout>

</FrameLayout>