<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="medicalConfig"
            type="org.intelehealth.app.ui.baseline_survey.config.MedicalBaselineConfig" />

        <variable
            name="baselineEditMode"
            type="Boolean" />

        <variable
            name="baseline"
            type="org.intelehealth.app.ui.baseline_survey.model.Baseline" />
        <variable
            name="generalConfig"
            type="org.intelehealth.app.ui.baseline_survey.config.GeneralBaselineConfig" />


    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/nested_linelist"
            android:layout_marginBottom="@dimen/margin_24"
            android:fillViewport="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/frag2_btn_next"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_20"
                android:paddingEnd="@dimen/padding_20">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10dp"
                    android:lineSpacingExtra="3sp"
                    android:text="@string/medical_history"
                    android:textColor="@color/deepBlue3"
                    tools:text="Medical History"
                    tools:textFontWeight="700" />

                <include
                    android:id="@+id/layout_bp_medication"
                    layout="@layout/layout_hypertension_medication_basline"
                    tools:visibility="visible"
                    app:baseline="@{baseline}"
                    app:medicalConfig="@{medicalConfig}"
                    app:baselineEditMode="@{baselineEditMode}"
                    />

                <include
                    android:id="@+id/layout_diabetes_medication"
                    layout="@layout/layout_diabetes_medication_basline"
                    tools:visibility="visible"
                    app:baseline="@{baseline}"
                    app:medicalConfig="@{medicalConfig}"
                    app:baselineEditMode="@{baselineEditMode}" />

                <include
                    android:id="@+id/layout_anemia_medication"
                    layout="@layout/layout_anemia_medication_baseline"
                    tools:visibility="visible"
                    app:baseline="@{baseline}"
                    app:medicalConfig="@{medicalConfig}"
                    app:baselineEditMode="@{baselineEditMode}"
                   />
                <TextView
                    android:id="@+id/tv_heading_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10dp"
                    android:lineSpacingExtra="3sp"
                    android:text="@string/baseline_general"
                    android:textColor="@color/deepBlue3"
                    tools:text="Medical History"
                    tools:textFontWeight="700" />

                <include
                    android:id="@+id/layout_whatsapp_general"
                    layout="@layout/layout_whataspp_details_baseline_common"
                    tools:visibility="visible"
                    app:baseline="@{baseline}"
                    app:generalConfig="@{generalConfig}" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/frag2_btn_next"
            style="@style/AppTheme.OutlinedButton.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/std_16dp"
            android:layout_marginEnd="@dimen/std_16dp"
            android:layout_marginBottom="@dimen/std_16dp"
            android:text="@string/save"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>