<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/frame_10021"
    android:orientation="vertical"
    tools:context=".activities.filterPatientActivity.FilterResultActivity">
    <!--    Toolbar - start -->
    <RelativeLayout
        android:id="@+id/toolbar_relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/my_appointment_parent_padding"
        android:paddingEnd="@dimen/my_appointment_parent_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back_arrow"
            android:layout_width="@dimen/hamburger_width"
            android:layout_height="@dimen/hamburger_height"
            android:layout_marginTop="@dimen/hamburger_margin_top"
            android:layout_marginEnd="@dimen/hamburger_margin_top"
            android:foregroundGravity="center_horizontal"
            app:srcCompat="@drawable/ui2_ic_arrow_back_new" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_screen_title_common"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/custom_tool_title_margin_top"
            android:layout_toEndOf="@+id/iv_back_arrow"
            android:text="Registry Check"
            android:textColor="@color/textColorBlack"
            android:textSize="@dimen/common_header_text_size"
            android:textStyle="bold" />

        <!--<androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/custom_tool_title_margin_top"
            android:layout_marginEnd="8dp"
            android:text="3 found"
            android:textColor="@color/textColorBlack"
            android:textSize="@dimen/common_header_text_size"
            android:textStyle="bold" />-->

    </RelativeLayout>
    <LinearLayout
        android:id="@+id/matches_layout"
        app:layout_constraintTop_toBottomOf="@id/toolbar_relative"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_margin="@dimen/space_10dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registry Matches Found"
            >

        </TextView>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/matches_layout"
        >

        <LinearLayout
            android:id="@+id/filter_patient_success_ll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filter_patient_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/filter_result_item_layout"
                tools:itemCount="5"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/margin_20" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/filter_patient_failed_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/search_bg_icon"
                android:layout_width="@dimen/search_icon_bg_dimens"
                android:layout_height="@dimen/search_icon_bg_dimens"
                android:src="@drawable/ic_search_icon_background" />

            <TextView
                android:id="@+id/search_pat_not_found_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingExtra="4sp"
                android:text="@string/search_pat_not_found_txt"
                android:textAppearance="@style/you_can_add"
                android:textColor="@null"
                android:textSize="@dimen/search_pat_notfound_txtsize"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/add_new_patient_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_end_visit"
                android:layout_marginTop="@dimen/toolbar_margin_right"
                android:layout_marginBottom="@dimen/margin_20dp"
                android:clickable="true"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/user_plus"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_activity_identification"
                    android:textColor="@color/white"
                    android:fontFamily="@font/dm_sans"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
    <!--    Toolbar - end -->
</androidx.constraintlayout.widget.ConstraintLayout>