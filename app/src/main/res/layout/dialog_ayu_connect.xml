<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <!-- Header Icon + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <!-- Mic Icon Circle -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_light_blue"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/selector_mic"
                    app:tint="#5B8DEF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ayu_connect_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ayu_connect_subtitle"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ayu_connect_description"
            android:textSize="13sp"
            android:textColor="#555555"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="4dp"/>

        <!-- Device Connection Status Bar -->
        <LinearLayout
            android:id="@+id/llDeviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_bar"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <!-- Status dot -->
            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_disconnected"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ayu_connect_status_disconnected"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tvStatusSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ayu_connect_subtext_disconnected"
                    android:textSize="11sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <!-- Scan button -->
            <TextView
                android:id="@+id/btnScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ayu_connect_scan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#5B8DEF"
                android:background="@drawable/bg_scan_btn"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <ProgressBar
                android:id="@+id/pbScanning"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Heart Sounds Card -->
        <LinearLayout
            android:id="@+id/cardHeart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sound_card"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Left: icon -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_light_blue"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/selector_mic"
                    app:tint="#E05C5C" />
            </FrameLayout>

            <!-- Middle: title + subtitle + progress -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heartSounds"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E" />

                <!-- Count label set at runtime via sound_recorded_count_format, e.g. "2 / 4 recorded" -->
                <TextView
                    android:id="@+id/tvHeartSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="6dp"/>

                <!-- Progress bar for heart -->
                <ProgressBar
                    android:id="@+id/pbHeart"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="4"
                    android:progress="0"
                    android:progressTint="#E05C5C"
                    android:progressBackgroundTint="#F0D0D0" />

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="#AAAAAA" />
        </LinearLayout>

        <!-- Lung Sounds Card -->
        <LinearLayout
            android:id="@+id/cardLung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sound_card"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Left: icon -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_light_blue"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/selector_mic"
                    app:tint="#5B8DEF" />
            </FrameLayout>

            <!-- Middle: title + subtitle + progress -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lungSounds"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E" />

                <!-- Count label set at runtime via sound_recorded_count_format, e.g. "6 / 16 recorded" -->
                <TextView
                    android:id="@+id/tvLungSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="6dp"/>

                <!-- Progress bar for lung -->
                <ProgressBar
                    android:id="@+id/pbLung"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="16"
                    android:progress="0"
                    android:progressTint="#5B8DEF"
                    android:progressBackgroundTint="#D0DCF8" />

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="#AAAAAA" />
        </LinearLayout>

        <!-- Shown only once every required sound (heart + lung) is recorded -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/next"
            android:visibility="gone"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary"
            android:layout_marginBottom="8dp" />

        <!-- Cancel -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:visibility="gone"
            android:textColor="#666666"
            android:background="@android:color/transparent"
            android:elevation="0dp" />

    </LinearLayout>
</ScrollView>