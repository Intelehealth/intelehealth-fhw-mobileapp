<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/std_16dp">


    <EditText
        android:id="@+id/etv_1st_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/std_8dp"
        android:background="@drawable/edit_box_round_corner_gray_light"
        android:fontFamily="@font/lato_regular"
        android:hint="Enter number"
        android:inputType="number"
        android:minHeight="42dip"
        android:padding="@dimen/std_8dp"
        android:textColor="@color/gray_6"
        android:textColorHint="@color/medium_gray"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etv_2nd_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/std_8dp"
        android:background="@drawable/edit_box_round_corner_gray_light"
        android:fontFamily="@font/lato_regular"
        android:hint="Enter number"
        android:inputType="number"
        android:minHeight="42dip"
        android:padding="@dimen/std_8dp"
        android:textColor="@color/gray_6"
        android:textColorHint="@color/medium_gray"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_24"
        android:layout_marginBottom="@dimen/margin_32dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/negative_btn"
            style="@style/positive_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/fu_margin_start"
            android:background="@drawable/ui2_common_input_bg"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/txtsize_patdetail_16sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/positive_btn"
            style="@style/positive_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/negative_btn"
            android:background="@drawable/primary_bg_rounded_corners"
            android:gravity="center"
            android:paddingHorizontal="@dimen/padding_15"
            android:paddingVertical="@dimen/padding_12"
            android:text="@string/submit" />
    </LinearLayout>

</LinearLayout>