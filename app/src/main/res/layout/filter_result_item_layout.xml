<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="24dp"
    app:strokeWidth="2dp"
    app:strokeColor="#3D6F12"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amara Diallo"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E1E1E"/>

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="F · 32 yrs · DOB 12 Mar 1994"
                    android:textSize="14sp"
                    android:textColor="#8A8A8A"/>
            </LinearLayout>


        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            >
            <TextView
                android:id="@+id/tvIHScoreTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#355F14"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvNrScoreTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text=""
                android:textColor="#355F14"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Tags -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ihNetworkTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IH Network"
                android:textColor="#0E5B4C"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tag_green"/>

            <TextView
                android:id="@+id/nrNetworkTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="National Registry"
                android:textColor="#7A2741"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tag_pink"/>
            <TextView
                android:id="@+id/noNRNetworkTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="No registry ID"
                android:textColor="#A2521E"
                android:textStyle="bold"
                android:textSize="14sp"
                android:visibility="gone"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_status_1"/>

            <!--<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="CR-0000123"
                android:textColor="#3F3D98"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_tag_purple"/>-->
        </LinearLayout>

        <!-- Button -->
        <Button
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Link &amp; Continue"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>