<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_8"
        android:gravity="center_vertical"
        android:lineSpacingExtra="1sp"
        android:text="Question 1 ?"
        android:textColor="@color/ui2_black_text_color"
        android:textSize="@dimen/txtsize_patdetail_14sp"
        app:drawableStartCompat="@drawable/ui2_next_icon_soft_rd" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_18">

        <TextView
            android:id="@+id/tv_question_desc"
            style="@style/label_misc_txt_14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="1sp"
            android:text="@string/select_any_one" />

        <TextView
            android:id="@+id/tv_know_more"
            style="@style/label_misc_txt_14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_24"
            android:drawablePadding="@dimen/margin_8"
            android:lineSpacingExtra="1sp"
            android:text="@string/know_more_txt"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:drawableEndCompat="@drawable/info_blue_svg" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_nested_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_8" />

    <LinearLayout
        android:id="@+id/ll_single_component_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:orientation="vertical" />

    <!-- <LinearLayout
         android:id="@+id/ll_others_container"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="@dimen/margin_16"
         android:orientation="vertical" />-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_super_nested_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_8" />

    <!-- Digital Stethoscope UI -->
    <LinearLayout
        android:id="@+id/ll_digital_auscultation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_18"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Clinical Recommendation Card -->
        <LinearLayout
            android:id="@+id/ll_digital_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_16"
            android:background="@drawable/bg_clinically_rec"
            android:orientation="vertical"
            android:padding="@dimen/margin_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/margin_24"
                    android:layout_height="@dimen/margin_24"
                    android:src="@drawable/ic_info"
                    app:tint="#0fd197" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/margin_8"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/clinicallyRecommended"
                    android:textColor="#0fd197"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_recommendation_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/dm_sans"
                android:text="Based on patient reporting Cough"
                android:textColor="#1b163a"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Digital Auscultation Control Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_12"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ellipse_user_digital" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans"
                            android:text="Digital Auscultation"
                            android:textColor="#1B163A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_upcoming_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans"
                            android:text="4 Upcoming"
                            android:textColor="#7F7B92"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/heartSounds"
                        android:textColor="#7F7B92"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_heart_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_digital_lablel"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="0/4 PENDING"
                        android:textColor="#7F7B92"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/lungSounds"
                        android:textColor="#7F7B92"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_lung_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_digital_lablel"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="0/4 PENDING"
                        android:textColor="#7F7B92"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_connect_device_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/ui2_common_primary_bg"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/connectdevice"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_skip_stethoscope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/skipfornow"
                    android:textColor="#2E2A85"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_16"
        android:gravity="end">

        <Button
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ui2_common_button_bg_submit"
            android:drawablePadding="8dip"
            android:paddingHorizontal="@dimen/margin_16"
            android:text="@string/skip_new"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/common_button_text_size"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_24"
            android:background="@drawable/ui2_common_button_bg_submit"
            android:drawablePadding="8dip"
            android:paddingHorizontal="@dimen/margin_16"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/common_button_text_size"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>


