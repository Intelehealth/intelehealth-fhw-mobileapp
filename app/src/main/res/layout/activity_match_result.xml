<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/frame_10021"
    tools:context=".ui.patient.activity.filter.MatchResultActivity">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:paddingStart="@dimen/my_appointment_parent_padding"
        android:paddingEnd="@dimen/my_appointment_parent_padding"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back_arrow"
            android:layout_width="@dimen/hamburger_width"
            android:layout_height="@dimen/hamburger_height"
            app:srcCompat="@drawable/ui2_ic_arrow_back_new" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_screen_title_common"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_back_arrow"
            android:layout_marginStart="10dp"
            android:text="Registry Check"
            android:textStyle="bold"
            android:textColor="@color/textColorBlack"
            android:textSize="@dimen/common_header_text_size" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:orientation="horizontal"
            >
            <ImageView
                android:id="@+id/refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:background="@null"
                android:elevation="8dip"
                android:onClick="syncNow"
                android:src="@drawable/ic_refreshbtn" />
        </LinearLayout>

    </RelativeLayout>

    <!-- Scroll Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/root_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar_relative"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ONLY ONE CHILD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Matches -->
            <LinearLayout
                android:id="@+id/matches_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/match_foundTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registry Matches Found"
                    android:textSize="16sp"/>
            </LinearLayout>

            <!-- Frame -->
            <FrameLayout
                android:id="@+id/frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Success Layout -->
                <LinearLayout
                    android:id="@+id/filter_patient_success_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/filter_patient_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/margin_20"
                        tools:itemCount="5"
                        tools:listitem="@layout/filter_result_item_layout" />

                </LinearLayout>

                <!-- Failed Layout -->
                <LinearLayout
                    android:id="@+id/filter_patient_failed_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/search_bg_icon"
                        android:layout_width="@dimen/search_icon_bg_dimens"
                        android:layout_height="@dimen/search_icon_bg_dimens"
                        android:src="@drawable/ic_search_icon_background" />

                    <TextView
                        android:id="@+id/search_pat_not_found_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/search_pat_not_found_txt"
                        android:textStyle="bold" />

                </LinearLayout>
            </FrameLayout>

            <!-- Bottom Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/margin_10"
                android:layout_marginLeft="@dimen/margin_10"
                android:layout_marginBottom="60dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/noneMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_10dp"
                    android:background="@drawable/button_bg"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:text="Proceed with new registration"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>