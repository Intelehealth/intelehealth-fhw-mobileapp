<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@color/white"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".activities.questionNodeActivity.QuestionNodeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--<com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/AppTheme.AppBarOverlay">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/AppTheme.PopupOverlay" />

        </com.google.android.material.appbar.AppBarLayout>-->


        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="?actionBarSize"
            android:paddingHorizontal="@dimen/toolbar_margin_left">

            <ImageButton
                android:id="@+id/img_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:background="@null"
                android:contentDescription="img_btn_cancel"
                android:onClick="backPress"
                app:srcCompat="@drawable/cancel_btn_cross" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/imb_btn_refresh"
                android:gravity="center_vertical"
                android:lineSpacingExtra="1sp"
                android:text="Lincon Testing"
                android:textAppearance="@style/label"
                android:textColor="@null"
                android:textSize="@dimen/toolbar_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_title_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_title"
                android:layout_toStartOf="@+id/imb_btn_refresh"
                android:gravity="center_vertical"
                android:lineSpacingExtra="1sp"
                android:text="Lincon Testing"
                android:textAppearance="@style/caption_fu_openmrsId"
                android:textColor="@null"
                android:textSize="@dimen/text_13sp"
                android:textStyle="normal" />

            <ImageButton
                android:id="@+id/imb_btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/common_title_margin_top"
                android:layout_toStartOf="@+id/img_btn_cancel"
                android:background="@null"
                android:contentDescription="imb_btn_refresh"
                android:onClick="syncNow"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_refreshbtn" />


        </RelativeLayout>

        <TextView
            android:id="@+id/tv_sub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbar"
            android:layout_marginTop="@dimen/margin_8"
            android:lineSpacingExtra="1sp"
            android:paddingHorizontal="@dimen/toolbar_margin_left"
            android:text="@string/screening_questionnaire_txt"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/toolbar_text_size"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/prog_bar_step1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dip"
            android:layout_below="@id/tv_sub_title"
            android:layout_marginVertical="8dip"
            android:progress="100"
            android:progressTint="@color/colorPrimary" />

        <org.intelehealth.app.utilities.pageindicator.ScrollingPagerIndicator
            android:id="@+id/recyclerViewIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            app:layout_constraintTop_toBottomOf="@+id/recyclerView"
            app:spi_dotSelectedColor="@color/colorPrimary"
            app:spi_visibleDotCount="21">

        </org.intelehealth.app.utilities.pageindicator.ScrollingPagerIndicator>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/question_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarThumbVertical="@color/colorAccent"
            android:scrollbars="vertical"
            android:visibility="visible" />

        <include
            layout="@layout/content_question_node"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>


    <RelativeLayout
        android:id="@+id/rl_nav_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="visible">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/back_desc"
            android:visibility="visible"
            app:rippleColor="@color/amber"
            app:srcCompat="@drawable/ic_back_arrow"
            app:useCompatPadding="true" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/next_desc"
            android:visibility="visible"
            app:rippleColor="@color/amber"
            app:srcCompat="@drawable/ic_forward_arrow"
            app:useCompatPadding="true" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="TODO"
            android:visibility="visible"
            app:rippleColor="@color/amber"
            app:srcCompat="@drawable/ic_done_24dp"
            app:useCompatPadding="true" />


    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_timer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:background="@color/colorPrimaryTrans"
        android:clickable="true"
        android:elevation="16dp"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        android:paddingBottom="150dip"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_timer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blood pressure measurement - 2"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="04:30"
            android:textColor="@color/white"
            android:textSize="42sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>