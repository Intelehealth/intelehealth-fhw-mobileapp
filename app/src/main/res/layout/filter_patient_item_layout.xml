<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fu_cardview_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="@dimen/margin_5"
    app:cardBackgroundColor="#F8EFDC"
    app:cardCornerRadius="@dimen/margin_10"
    app:cardElevation="@dimen/margin_5">

    <RelativeLayout
        android:id="@+id/patientListRal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/tab_icon_18dp">

        <!-- Right Arrow -->
        <ImageButton
            android:id="@+id/btnArrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ui2_ic_baseline_arrow_forward_24"
            android:contentDescription="Open"
            app:tint="#6F2326"/>

        <!-- Left Content -->
        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnArrow"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/filter_txt_possible_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Possible Duplicate Found locally"
                android:textColor="#6F2326"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/filter_txt_Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#6F2326"
                android:textSize="@dimen/fu_name_txt_size"/>

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>