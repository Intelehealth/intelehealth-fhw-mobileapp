<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fu_cardview_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/margin_10"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="@dimen/margin_5"
    app:cardBackgroundColor="#F8EFDC"
    app:cardElevation="@dimen/margin_5">

    <RelativeLayout
        android:layout_width="match_parent"
        android:padding="@dimen/tab_icon_18dp"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/filter_txt_possible_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lineSpacingExtra="3sp"
            android:layout_marginStart="@dimen/space_5dp"

            android:maxLines="2"
            android:text="Possible Duplicate Found locally"
            android:textAppearance="@style/label"
            android:textColor="#6F2326"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/filter_txt_Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/space_5dp"
            android:layout_below="@id/filter_txt_possible_type"
            android:gravity="center_vertical"
            android:lineSpacingExtra="3sp"
            android:layout_marginStart="@dimen/space_5dp"
            android:maxLines="2"
            android:text=""
            android:textAppearance="@style/label"
            android:textColor="#6F2326"
            android:textSize="@dimen/fu_name_txt_size" />

        <!--<RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/fu_margin_start"
            android:layout_below="@id/filter_txt_possible_type"
            android:layout_toStartOf="@+id/rlPrioritySearchRowItem">

            <androidx.cardview.widget.CardView
                android:id="@+id/profile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_margin="2dp"
                android:elevation="0dp"
                app:cardCornerRadius="20dp">

                <ImageView
                    android:id="@+id/profile_imgview"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/avatar1" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fu_margin_start"
                android:layout_toEndOf="@+id/profile"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filter_txt_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="3sp"
                    android:maxLines="1"
                    android:text="test"
                    android:textAppearance="@style/label"
                    android:textColor="@null"
                    android:textSize="@dimen/fu_name_txt_size" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filter_txt_dob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3sp"
                    android:layout_marginTop="@dimen/cal_margin_top"
                    android:text="@string/search_date_txt"
                    app:drawableStartCompat="@drawable/followup_item_calendar"
                    app:drawableTint="@color/colorAccent"
                    android:drawablePadding="@dimen/cal_margnin_start"
                    android:textColor="@color/search_followup"
                    android:textSize="@dimen/fu_male_textsize" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/filter_txt_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3sp"
                    android:layout_marginTop="@dimen/cal_margin_top"
                    tools:text="+91999999999"
                    app:drawableStartCompat="@drawable/ic_phone"
                    app:drawableTint="@color/colorAccent"
                    android:drawablePadding="@dimen/cal_margnin_start"
                    android:textColor="@color/search_followup"
                    android:textSize="@dimen/fu_male_textsize" />
                &lt;!&ndash;<TextView
                    android:id="@+id/filter_txt_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3sp"
                    android:text="@string/source"
                    android:paddingRight="5dp"
                    android:layout_marginTop="@dimen/margin_5"
                    android:layout_marginBottom="@dimen/margin_5"
                    />&ndash;&gt;

            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/rlPrioritySearchRowItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/fu_margin_start"
            android:layout_marginEnd="@dimen/fu_margin_start"
            android:layout_below="@id/filter_txt_possible_type"
            android:orientation="vertical">

            <TextView
                android:id="@+id/filter_txt_gender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cal_margnin_start"
                android:layout_gravity="end"
                android:lineSpacingExtra="3sp"
                android:text="@string/search_gender"
                android:paddingRight="5dp"
                android:textAppearance="@style/label_misc_txt_14sp"
                android:textColor="@null"
                android:textSize="@dimen/fu_name_txt_size"/>

           &lt;!&ndash; <RadioButton
                android:id="@+id/filter_patient_selected"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_gravity="center_horizontal"/>&ndash;&gt;
            <TextView
                android:id="@+id/filter_txt_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:lineSpacingExtra="3sp"
                android:text="@string/score"
                android:paddingRight="5dp"
                android:layout_marginTop="@dimen/margin_5"
                android:layout_marginBottom="@dimen/margin_5"
                />
        </LinearLayout>-->
    </RelativeLayout>
</androidx.cardview.widget.CardView>
