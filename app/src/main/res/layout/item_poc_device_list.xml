<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_connect"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="@dimen/margin_20"
        app:cardElevation="@dimen/margin_5"
        app:cardCornerRadius="@dimen/margin_5"
        app:cardBackgroundColor="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:padding="@dimen/margin_5"
            android:layout_margin="@dimen/margin_5"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_condeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center|start"
                    android:lineSpacingExtra="1sp"
                    android:paddingHorizontal="@dimen/margin_10"
                    android:textSize="@dimen/margin_18"
                    android:text="@string/wireless" />
                <TextView
                    android:id="@+id/tv_deviceAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center|start"
                    android:lineSpacingExtra="1sp"
                    android:textColor="@null"
                    android:textAppearance="@style/caption"
                    android:paddingHorizontal="@dimen/margin_10"
                    android:textSize="@dimen/margin_14"
                    android:text="@string/connected_via_bluetooth" />
            </LinearLayout>
            <Button
                android:id="@+id/btn_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_weight="2"
                android:layout_gravity="center"
                android:backgroundTint="@color/textColorLightGary"
                android:background="@drawable/ui2_common_primary_bg"
                android:lineHeight="@dimen/button_skip_line_height"
                android:paddingEnd="@dimen/margin_5"
                android:text="@string/connect"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/common_button_text_size" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>