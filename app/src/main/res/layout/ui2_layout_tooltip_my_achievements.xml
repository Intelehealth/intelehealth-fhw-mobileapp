<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tooltip_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    card_view:cardElevation="0dp"
    android:layout_marginTop="4dp"
    card_view:cardCornerRadius="6dp"
    card_view:cardUseCompatPadding="true">

    <LinearLayout
        android:id="@+id/tooltip_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Triangle pointing up, now aligned to end (right side) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/tooltip_triangle"
                android:layout_width="16dp"
                android:layout_height="8dp"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:src="@drawable/triangle_up"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Tooltip content -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_tooltip_rounded">

            <TextView
                android:id="@+id/tooltip_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tooltip Title"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tooltip_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tooltip description here"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
