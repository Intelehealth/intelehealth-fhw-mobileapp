<?xml version="1.0" encoding="utf-8"?>
<!-- "Visit Submitted" popup shown after a visit is sent while QMS is configured.
     Confirms the patient was added to the doctor's queue, shows the estimated
     wait time, and offers "View Queue" / "Back to Home". -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_5"
    app:cardCornerRadius="@dimen/margin_16dp"
    app:cardElevation="@dimen/hamburger_margin_start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_24"
        android:paddingTop="@dimen/margin_32dp"
        android:paddingEnd="@dimen/margin_24"
        android:paddingBottom="@dimen/margin_24">

        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="@dimen/patregist_profileimg_icon"
            android:layout_height="@dimen/patregist_profileimg_icon"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/dialog_visit_sent_success_icon" />

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_24"
            android:gravity="center"
            android:lineSpacingExtra="4sp"
            android:text="@string/visit_submitted"
            android:textAppearance="@style/dialog_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fu_margin_start"
            android:gravity="center"
            android:lineSpacingExtra="3sp"
            android:text="@string/patient_added_to_doctor_queue"
            android:textAppearance="@style/dialog_subtitle" />

        <!-- Wait time card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_24"
            android:background="@drawable/bg_rounded_lavender_queue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin_16dp"
            android:paddingTop="@dimen/margin_16dp"
            android:paddingEnd="@dimen/margin_16dp"
            android:paddingBottom="@dimen/margin_16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:text="@string/wait_time"
                android:textColor="@color/textColorGray"
                android:textSize="@dimen/txtsize_patdetail_16sp" />

            <TextView
                android:id="@+id/tv_wait_time_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lato_bold"
                android:gravity="center_horizontal"
                android:text="@string/wait_time_default_value"
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/txtsize_patdetail_16sp"
                android:textStyle="bold"
                tools:text="8 mins" />
        </LinearLayout>

        <!-- View Queue (primary) -->
        <Button
            android:id="@+id/btn_view_queue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fu_btn_size"
            android:layout_marginTop="@dimen/margin_16dp"
            android:background="@drawable/ui2_common_primary_bg"
            android:gravity="center"
            android:text="@string/view_queue"
            android:textColor="@color/white"
            android:textSize="@dimen/common_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Back to Home (secondary) -->
        <Button
            android:id="@+id/btn_back_to_home"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fu_btn_size"
            android:layout_marginTop="@dimen/margin_8"
            android:background="@drawable/bg_rounded_lavender"
            android:gravity="center"
            android:text="@string/back_to_home"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/common_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
