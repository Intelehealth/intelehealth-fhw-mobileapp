<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_5"
    app:cardCornerRadius="@dimen/margin_16dp"
    app:cardElevation="@dimen/hamburger_margin_start">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="@dimen/patregist_profileimg_icon"
            android:layout_height="@dimen/patregist_profileimg_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_32dp"
            android:src="@drawable/dialog_icon_complete" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/dialog_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginTop="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24">

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:lineSpacingExtra="4sp"
                android:text="@string/abha"
                android:textAppearance="@style/dialog_title"
                android:textStyle="bold"
                android:textColor="@null"
                android:textSize="@null" />

            <TextView
                android:id="@+id/dialog_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/dialog_title"
                android:layout_marginTop="@dimen/fu_margin_start"
                android:gravity="center"
                android:lineSpacingExtra="3sp"
                android:text="@string/do_you_have_your_abha_number"
                android:textAppearance="@style/dialog_subtitle"
                android:textColor="@null"
                android:textSize="@null" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dialog_subtitle"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/margin_24"
                android:layout_marginHorizontal="@dimen/margin_24"
                android:layout_marginBottom="@dimen/margin_32dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/yes_abha_btn"
                    style="@style/positive_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:background="@drawable/ui2_common_primary_bg"
                    android:paddingHorizontal="@dimen/margin_32dp"
                    android:paddingVertical="@dimen/margin_20dp"
                    android:layout_marginBottom="@dimen/fu_margin_start"
                    android:text="@string/yes" />

                <Button
                    android:id="@+id/create_abha_btn"
                    style="@style/negative_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/fu_margin_start"
                    android:background="@drawable/ui2_common_primary_bg_disabled"
                    android:paddingHorizontal="@dimen/margin_32dp"
                    android:paddingVertical="@dimen/margin_20dp"
                    android:text="Create ABHA" />

                <Button
                    android:id="@+id/continue_without_abha_btn"
                    style="@style/negative_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:background="@drawable/ui2_common_primary_bg_disabled"
                    android:paddingHorizontal="@dimen/margin_32dp"
                    android:paddingVertical="@dimen/margin_20dp"
                    android:text= "Continue without ABHA" />
            </LinearLayout>


        </RelativeLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>