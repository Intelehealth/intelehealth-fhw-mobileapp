<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/subquestion_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:contentDescription="@null"
        android:paddingStart="16dp"
        android:paddingTop="@dimen/padding_complaint_select"
        android:paddingEnd="12dp"
        android:paddingBottom="@dimen/padding_complaint_select" />

    <TextView
        android:id="@+id/subquestion_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:focusable="false"
        android:fontFamily="@font/lato_regular"
        android:paddingTop="@dimen/padding_complaint_select"
        android:paddingEnd="20dp"
        android:paddingBottom="@dimen/padding_complaint_select"
        android:textSize="@dimen/card_content_text_size"
        android:textStyle="normal" />

</LinearLayout>
