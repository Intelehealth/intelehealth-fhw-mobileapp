        <LinearLayout
            android:id="@+id/ll_digital_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_20"
            android:layout_marginTop="@dimen/margin_20"
            android:background="@drawable/bg_clinically_rec"
            android:layout_marginBottom="@dimen/margin_10"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_6"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/recommendationImage"
                    android:layout_width="@dimen/margin_30"
                    android:layout_height="@dimen/margin_30"
                    android:layout_gravity="center"
                    android:backgroundTint="#0fd197"
                    android:contentDescription="Medical recommendation notice"
                    android:src="@drawable/ic_info" />

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_2dp"
                    android:text="@string/clinicallyRecommended"
                    android:textColor="#0fd197"
                    android:layout_gravity="center"
                    android:textSize="@dimen/margin_16"
                    android:fontFamily="@font/dm_sans"
                    android:textFontWeight="600" />
            </LinearLayout>

            <TextView
                android:id="@+id/symptomText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_2dp"
                android:layout_marginStart="@dimen/margin_6"
                android:text="@string/symptomBreathlessness"
                android:textColor="#1b163a"
                android:fontFamily="@font/dm_sans"
                android:textSize="18dp" />

            <!-- Recommendation -->
            <TextView
                android:id="@+id/recommendationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/integratedPOCDigitalstethoscoperecommendedforcomprehensiveevaluation"
                android:textColor="#7F7B92"
                android:layout_marginStart="@dimen/margin_6"
                android:fontFamily="@font/dm_sans"
                android:textSize="16dp" />


        </LinearLayout>


        <LinearLayout
            android:id="@+id/lldigital_auscultation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_digital_note"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_heart_lung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_20"
                android:layout_marginTop="@dimen/margin_20"
                android:layout_marginBottom="@dimen/margin_10"
                app:cardCornerRadius="@dimen/margin_5"
                app:cardElevation="@dimen/margin_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_10">

                    <LinearLayout
                        android:id="@+id/liner_title_digital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_2dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/margin_10">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:scaleType="center"
                            android:src="@drawable/ellipse_user_digital" />

                        <View
                            android:layout_width="0.5dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/margin_5"
                            android:background="@color/white" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="center|start"
                                android:letterSpacing="0"
                                android:lineHeight="@dimen/margin_15"
                                android:lineSpacingExtra="1sp"
                                android:paddingHorizontal="@dimen/margin_10"
                                android:text="Digital Ausucultation"
                                android:textColor="#1B163A"
                                android:textSize="@dimen/margin_16" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center|start"
                                android:lineSpacingExtra="1sp"
                                android:paddingHorizontal="@dimen/margin_10"
                                android:text="4 Upcoming"
                                android:textColor="#7F7b92"
                                android:textSize="@dimen/margin_14" />
                        </LinearLayout>

                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_bluetooth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_6"
                        app:cardCornerRadius="@dimen/margin_5"
                        app:cardElevation="@dimen/margin_5">

                        <LinearLayout
                            android:id="@+id/lldevice_connected"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/cv_select"
                            android:layout_margin="@dimen/margin_6"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_condevicename"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center|start"
                                    android:text="AYUSYNK Connected"
                                    android:layout_gravity="center"
                                    android:textColor="#1B163A"
                                    android:textSize="@dimen/margin_12" />

                                <com.ayudevices.cardiosynksdk.battery.AyuBatteryMeterView
                                    android:id="@+id/customBatteryMeter"
                                    android:layout_width="50dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:layout_marginHorizontal="@dimen/margin_5"
                                    android:visibility="invisible"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <Button
                                    android:id="@+id/btn_disconnect"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center|end"
                                    android:layout_weight="1"
                                    android:background="@drawable/ui2_common_primary_bg"
                                    android:text="@string/disconnect"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/txtsize_patdetail_14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center|start"
                                    android:lineSpacingExtra="1sp"
                                    android:textColor="#7F7B92"
                                    android:text="@string/device_strength"
                                    android:textSize="@dimen/toolbar_text_size" />

                                <TextView
                                    android:id="@+id/tvdeviceStrength"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center|start"
                                    android:lineSpacingExtra="1sp"
                                    android:paddingHorizontal="@dimen/margin_10"
                                    android:text="@string/strong"
                                    android:textColor="#0FD197"
                                    android:textSize="@dimen/toolbar_text_size" />

                            </LinearLayout>
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:id="@+id/ll_heart_sounds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_4"
                        android:layout_marginLeft="@dimen/margin_2dp"
                        android:layout_marginRight="@dimen/margin_2dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/margin_2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/heartSounds"
                            android:textColor="#7F7B92"
                            android:textSize="@dimen/margin_16" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_digital_lablel"
                            android:gravity="center"
                            android:paddingStart="@dimen/margin_8"
                            android:paddingTop="@dimen/margin_4"
                            android:paddingEnd="@dimen/margin_8"
                            android:paddingBottom="@dimen/margin_4"
                            android:text="0/4 PENDING"
                            android:textColor="#7F7B92"
                            android:textSize="@dimen/margin_14" />
                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:id="@+id/ll_lung_sounds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_2dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/margin_2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/lungSounds"
                            android:textColor="#7F7B92"
                            android:textSize="@dimen/margin_16" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_digital_lablel"
                            android:gravity="center"
                            android:paddingStart="@dimen/margin_8"
                            android:paddingTop="@dimen/margin_4"
                            android:paddingEnd="@dimen/margin_8"
                            android:paddingBottom="@dimen/margin_4"
                            android:text="0/4 PENDING"
                            android:textColor="#7F7B92"
                            android:textSize="@dimen/margin_14" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/bt_ble_connectdevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_12"
                        android:background="@drawable/ui2_common_primary_bg"
                        android:drawableTint="@color/iconTintWhite"
                        android:fontFamily="@font/dm_sans"
                        android:lineHeight="@dimen/button_skip_line_height"
                        android:paddingStart="@dimen/common_button_padding_left"
                        android:paddingTop="@dimen/common_button_padding_top"
                        android:paddingEnd="@dimen/common_button_padding_right"
                        android:paddingBottom="@dimen/common_button_padding_bottom"
                        android:text="@string/connectdevice"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/common_button_text_size"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/bt_ble_done"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_12"
                        android:background="@drawable/ui2_common_primary_bg"
                        android:drawableTint="@color/iconTintWhite"
                        android:fontFamily="@font/dm_sans"
                        android:lineHeight="@dimen/button_skip_line_height"
                        android:paddingStart="@dimen/common_button_padding_left"
                        android:paddingTop="@dimen/common_button_padding_top"
                        android:paddingEnd="@dimen/common_button_padding_right"
                        android:paddingBottom="@dimen/common_button_padding_bottom"
                        android:text="DONE"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/common_button_text_size"
                        android:textStyle="bold"
                        android:visibility="gone"/>
                    <Button
                        android:id="@+id/bt_ble_startRecording"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_12"
                        android:background="@drawable/ui2_common_primary_bg"
                        android:drawableTint="@color/iconTintWhite"
                        android:fontFamily="@font/dm_sans"
                        android:lineHeight="@dimen/button_skip_line_height"
                        android:paddingStart="@dimen/common_button_padding_left"
                        android:paddingTop="@dimen/common_button_padding_top"
                        android:paddingEnd="@dimen/common_button_padding_right"
                        android:paddingBottom="@dimen/common_button_padding_bottom"
                        android:text="@string/startRecording"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/common_button_text_size"
                        android:textStyle="bold"
                        android:visibility="gone"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="start"
                        android:text="@string/skipfornow"
                        android:textColor="#2E2A85"
                        android:textSize="@dimen/margin_16"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="@dimen/button_skip_margin_start"
            android:layout_marginBottom="@dimen/button_skip_margin_bottom"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/ui2_common_input_bg"
