<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    android:weightSum="1">

    <LinearLayout
        android:id="@+id/LL_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="0.88"
        android:gravity="top"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/physical_exam_image_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/physical_exam_img_max_height"
            android:layout_gravity="center_horizontal"
            android:contentDescription="TODO"
            android:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_ayu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_question_indicator"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tv_complaintQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/lato_bold"
                tools:text="@string/since_when_have_you_had_this_symptom"
                android:textColor="@color/primary_text"
                android:textSize="18sp"
                android:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/physical_exam_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/physical_node_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"

            android:scrollbarThumbVertical="@color/colorPrimary"
            android:fitsSystemWindows="true"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:fadeScrollbars="false"
            android:scrollbarFadeDuration="0"
            android:nestedScrollingEnabled="true"
            android:scrollbars="vertical" />

        <!-- Digital Stethoscope UI -->
        <LinearLayout
            android:id="@+id/ll_digital_auscultation_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_18"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Clinical Recommendation Card -->
            <LinearLayout
                android:id="@+id/ll_digital_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16"
                android:background="@drawable/bg_clinically_rec"
                android:orientation="vertical"
                android:padding="@dimen/margin_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/margin_24"
                        android:layout_height="@dimen/margin_24"
                        android:src="@drawable/ic_info"
                        app:tint="#0fd197" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/margin_8"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/clinicallyRecommended"
                        android:textColor="#0fd197"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_recommendation_reason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/dm_sans"
                    android:text="Based on patient reporting Cough"
                    android:textColor="#1b163a"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Digital Auscultation Control Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_12"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ellipse_user_digital" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:text="Digital Auscultation"
                                android:textColor="#1B163A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_upcoming_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:text="4 Upcoming"
                                android:textColor="#7F7B92"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:text="@string/heartSounds"
                            android:textColor="#7F7B92"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_heart_pending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_digital_lablel"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="0/4 PENDING"
                            android:textColor="#7F7B92"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:text="@string/lungSounds"
                            android:textColor="#7F7B92"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_lung_pending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_digital_lablel"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="0/4 PENDING"
                            android:textColor="#7F7B92"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_connect_device_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/ui2_common_primary_bg"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/connectdevice"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_skip_stethoscope"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/skipfornow"
                        android:textColor="#2E2A85"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>


        <!--        <appilities.AutoFitGridRecyclerView-->
        <!--            android:id="@+id/rv_chips"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_marginTop="5dp"-->
        <!--            android:listSelector="@android:color/transparent"-->
        <!--            android:numColumns="auto_fit"-->
        <!--            android:fitsSystemWindows="true"-->
        <!--            android:scrollbars="vertical" />-->


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight=".12">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_done_24dp" />

    </RelativeLayout>


</LinearLayout>


