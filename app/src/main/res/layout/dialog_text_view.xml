<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_5"
    app:cardCornerRadius="@dimen/margin_16dp"
    app:cardElevation="@dimen/hamburger_margin_start">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="@dimen/patregist_profileimg_icon"
            android:layout_height="@dimen/patregist_profileimg_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_32dp"
            android:contentDescription="@string/alert_icon"
            android:src="@drawable/close_patient_svg" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/dialog_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginTop="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24">

            <TextView
                android:id="@+id/dialog_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fu_margin_start"
                android:gravity="center"
                android:lineSpacingExtra="3sp"
                android:textAppearance="@style/dialog_subtitle"
                android:textColor="@null"
                android:textSize="@null"
                tools:text="@string/subheading_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/dialog_subtitle"
                android:layout_marginTop="@dimen/margin_24"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tv_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_fieldnew"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:paddingStart="@dimen/common_edittext_padding_left"
                    android:paddingTop="@dimen/common_edittext_padding_top"
                    android:paddingEnd="@dimen/common_edittext_padding_right"
                    android:paddingBottom="@dimen/common_edittext_padding_bottom"
                    android:singleLine="true"
                    android:textSize="@dimen/common_hint_text_size" />

            </com.google.android.material.textfield.TextInputLayout>

            <RelativeLayout
                android:id="@+id/rl_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/til_entry"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/margin_24"
                android:layout_marginBottom="@dimen/margin_32dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/negative_btn"
                    style="@style/negative_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/fu_margin_start"
                    android:background="@drawable/ui2_common_primary_bg_disabled"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/margin_32dp"
                    android:paddingVertical="@dimen/margin_20dp"
                    android:text="@string/no" />

                <Button
                    android:id="@+id/positive_btn"
                    style="@style/positive_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/negative_btn"
                    android:background="@drawable/ui2_common_primary_bg"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/margin_32dp"
                    android:paddingVertical="@dimen/margin_20dp"
                    android:text="@string/yes" />
            </RelativeLayout>

        </RelativeLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>