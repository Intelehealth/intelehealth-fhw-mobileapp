<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E4DC">

    <!-- Top Bar -->
    <!--<LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="#35209B"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking Registries"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"/>
    </LinearLayout>-->
    <!--    Toolbar - start -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/my_appointment_parent_padding"
        android:paddingEnd="@dimen/my_appointment_parent_padding"
        android:layout_marginTop="@dimen/space_10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back_arrow"
            android:layout_width="@dimen/hamburger_width"
            android:layout_height="@dimen/hamburger_height"
            android:layout_marginTop="@dimen/hamburger_margin_top"
            android:layout_marginEnd="@dimen/hamburger_margin_top"
            android:foregroundGravity="center_horizontal"
            app:srcCompat="@drawable/ui2_ic_arrow_back_new" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_screen_title_common"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/custom_tool_title_margin_top"
            android:layout_toEndOf="@+id/iv_back_arrow"
            android:text="Checking Registries"
            android:textColor="@color/textColorBlack"
            android:textSize="@dimen/common_header_text_size"
            android:textStyle="bold" />
    </RelativeLayout>
    <!--    Toolbar - end -->

    <!-- Main Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Patient Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_patient_card">

                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amara Diallo"
                    android:textColor="#332A9D"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/infoTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="F · DOB 12 March 1994 · Koidu Town, Kono District"
                    android:textColor="#4A4598"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Registry Card 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IH Network Search"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="#202020"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All Intelehealth clinic locations"
                                android:textColor="#8A8A8A"
                                android:textSize="14sp"/>
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/ihNetworkTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Found 2 matches"
                        android:visibility="gone"
                        android:textStyle="bold"
                        android:textColor="#2F5E0D"
                        android:textSize="16sp"/>

                    <ProgressBar
                        android:id="@+id/progressBarIH"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progressTint="#3E780A"
                        android:backgroundTint="#D9D9D9"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Registry Card 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/national_card_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="National Registry ($match)"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="#202020"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HAPI FHIR MDM via OpenHIM"
                                android:textColor="#8A8A8A"
                                android:textSize="14sp"/>
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/nrNetworkTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Found 1 match"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:textColor="#2F5E0D"
                        android:textSize="16sp"/>

                    <ProgressBar
                        android:id="@+id/progressBarNational"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progressTint="#3E780A"
                        android:backgroundTint="#D9D9D9"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <TextView
                        android:id="@+id/totalTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 matches found"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:textColor="#202020"
                        android:textSize="22sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Review before registering"
                        android:textColor="#8A8A8A"
                        android:textSize="16sp"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Cancel -->
           <!-- <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:text="Cancel"
                android:textColor="#8B8B84"
                android:textStyle="bold"
                android:textSize="18sp"/>-->

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>