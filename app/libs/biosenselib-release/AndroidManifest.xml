<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="biosense.sreyasvpariyath.com.biosenselib" >

    <uses-sdk android:minSdkVersion="21" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true" >
        <service
            android:name="biosense.sreyasvpariyath.com.biosenselib.services.BluetoothLeService"
            android:enabled="true" />
        <service
            android:name="biosense.sreyasvpariyath.com.biosenselib.services.QppLeService"
            android:enabled="true" />
    </application>

</manifest>