        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:drawableStart="@drawable/ic_baseline_search_24"
            android:drawablePadding="5dp"
            android:hint="@string/search_text_filed_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="@dimen/search_text_size" />
                </com.google.android.material.textfield.TextInputLayout>

-->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="15dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_patient_searched"
        tools:itemCount="3"
        tools:listitem="@layout/list_item_search_protocolwise" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_no_data_found"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="15dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_relative">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_patient_not_found"
            app:srcCompat="@drawable/ic_search_icon_background" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_patient_not_found"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="15sp"
            android:text="@string/patient_not_found"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_correct_string_message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15sp"
            android:gravity="center"
            android:text="@string/correct_search_string_message"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_create_new_patient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15sp"
            android:text="@string/add_new_patient"
            android:textAllCaps="false"
            app:icon="@drawable/user_plus"
            app:iconSize="20dp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

